# Public URL of the Express API (Railway)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL of this site (used for canonical URLs, sitemap, hreflang)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Storefront theme: forest (default — greens, moss, sand, ember) | classic (black / white / red)
NEXT_PUBLIC_THEME=forest

# Payment methods advertised in the footer / product / checkout pages (comma separated). This is only the shop window:
# what shoppers can really pay with is enabled in the Adyen Customer Area (remove "klarna" until Klarna is live on your account).
# Available: visa, mastercard, cb, applepay, googlepay, sepa, ideal, bancontact, klarna, paypal
NEXT_PUBLIC_PAYMENT_BADGES=visa,mastercard,cb,applepay,googlepay,sepa,ideal,bancontact,klarna

# Content-Security-Policy ships in report-only mode (violations are only logged in the browser console).
# After a full payment test (card, then Klarna) with a clean console, set this to true to start blocking.
CSP_ENFORCE=false
