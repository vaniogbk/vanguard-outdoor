# ───────── Core ─────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://vanguard:vanguard@localhost:5432/vanguard
# Railway Postgres uses an internal network → no SSL needed. Set true for external managed DBs.
DATABASE_SSL=false
# Signs every login token (and the newsletter unsubscribe links). In production the API REFUSES TO START unless this is
# random and at least 32 characters, so never keep this placeholder:   openssl rand -hex 48
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Admin sessions are shorter than customer ones (the role is also re-read from the database on every admin call)
ADMIN_JWT_EXPIRES_IN=12h

# ───────── URLs ─────────
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_VERCEL_PREVIEWS=false

# ───────── Payments ─────────
# Comma-separated, first = default. Options: adyen, payoneer, mock (mock is disabled in production)
PAYMENT_PROVIDERS=mock

# Adyen (Customer Area → Developers → API credentials / Webhooks)
ADYEN_ENVIRONMENT=test
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_CLIENT_KEY=
ADYEN_HMAC_KEY=
# live only, e.g. 1797a841fbb37ca7-AdyenDemo
ADYEN_LIVE_PREFIX=

# Payoneer Checkout (sandbox: https://api.sandbox.oscato.com · live: https://api.live.oscato.com)
PAYONEER_BASE_URL=https://api.sandbox.oscato.com
PAYONEER_MERCHANT_CODE=
PAYONEER_API_TOKEN=
PAYONEER_DIVISION=
# Required to use Payoneer (the provider and its webhook stay disabled without it): its own random value, NOT the JWT secret.
#   openssl rand -hex 24
PAYONEER_NOTIFICATION_SECRET=

# ───────── Catalogue import ─────────
FX_USD_EUR=0.86
PRICE_MULTIPLIER=1
IMPORT_DEFAULT_STOCK=50

# ───────── First admin (created by `npm run seed`) ─────────
# Set both BEFORE the site is public: the password below always wins over any account already registered with this address.
# Once you have logged in successfully, delete ADMIN_PASSWORD from the hosting dashboard (it is only needed for the first start).
ADMIN_EMAIL=
ADMIN_PASSWORD=
